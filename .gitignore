# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local

# PRD source document (not part of the app)
*.docx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / agent tooling (local IDE state, skills cache)
.qoder/

# local data dumps / scratch artifacts
/*.csv
/backup*.sql

# vercel deploy scratch (temporary CLI helper scripts)
.vercel-tmp/
