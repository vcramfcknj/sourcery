# Supabase project (create at https://supabase.com - free tier is fine for MVP)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin used to build the email-verification redirect
# (must match an Allowed Redirect URL in Supabase Auth settings).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key - SERVER ONLY. Never expose to the browser. Used by
# middleware/admin operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (primary AI provider - free tier, does not train on inputs, PRD 27.4).
# REQUIRED for Phase 3 question generation. Get a key at console.groq.com.
GROQ_API_KEY=

# Optional: override the Phase 3 model split (Open Question #3). Defaults are
# set in src/lib/constants.ts (generation openai/gpt-oss-120b, L2
# qwen/qwen3.8-27b, L3 judge openai/gpt-oss-20b). Only set these to tune.
# GROQ_GEN_MODEL=
# GROQ_L2_MODEL=
# GROQ_L3_MODEL=

# Database connection string for pg-boss background jobs (Phase 2).
# Supabase: Project Settings -> Database -> Connection string (uri).
DATABASE_URL=postgresql://postgres:***@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
